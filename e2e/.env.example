# EdgeCDN-X API the webhook talks to. The hostname below must be inside one of
# the Project's zones. Never commit the real .env file.
EDGECDNX_API_URL=https://api.edgecdnx.com
EDGECDNX_PROJECT_ID=my-project
EDGECDNX_API_KEY=changeme

# Hostname published by BOTH clusters (must belong to a Project zone).
E2E_HOSTNAME=app.example.com
# Optional: zone resource name (usually the zone itself) used by `make verify`
# to list the resulting DNS endpoints.
E2E_ZONE=example.com

# Routing scenario for the shared hostname: wrr | geo | rr | failover
E2E_ROUTING=wrr

# Optional HTTP(S) health check applied to each created Location.
# Leave E2E_HEALTH_ENDPOINT empty to skip.
E2E_HEALTH_ENDPOINT=/healthz
E2E_HEALTH_PROTOCOL=https
E2E_HEALTH_PORT=443

# --- Frankfurt cluster (kind cluster "fra") -------------------------------
# set-identifier = Location name created in EdgeCDN-X.
FRA_SET_IDENTIFIER=kind-fra
# Public IP written into the Ingress target annotation (becomes the node IP).
FRA_TARGET=203.0.113.10
# wrr scenario
FRA_WEIGHT=70
# geo scenario (comma-delimited codes; either may be empty)
FRA_CONTINENTS=EU
FRA_COUNTRIES=
# failover scenario
FRA_FAILOVER_ROLE=primary
FRA_FALLBACK=kind-ams

# --- Amsterdam cluster (kind cluster "ams") -------------------------------
AMS_SET_IDENTIFIER=kind-ams
AMS_TARGET=198.51.100.20
AMS_WEIGHT=30
AMS_CONTINENTS=NA,SA
AMS_COUNTRIES=
AMS_FAILOVER_ROLE=secondary
AMS_FALLBACK=

# --- Images ----------------------------------------------------------------
# Webhook image built from this repository and loaded into both kind clusters.
WEBHOOK_IMAGE=edgecdnx-external-dns-webhook:e2e
EXTERNAL_DNS_IMAGE=registry.k8s.io/external-dns/external-dns:v0.24.0

# Annotation prefix understood by the deployed external-dns version.
# v0.22.0+ default: external-dns.kubernetes.io
# older releases:   external-dns.alpha.kubernetes.io
#E2E_ANNOTATION_PREFIX=external-dns.kubernetes.io

# Log level for both external-dns and the webhook: debug | info
LOG_LEVEL=debug
